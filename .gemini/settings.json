{
  "hooks": {
    "AfterTool": [
      {
        "hooks": [
          {
            "command": "sh \"$GEMINI_PROJECT_DIR/.gemini/hooks/raven-run-hook.sh\" .gemini/hooks/raven-post-bash-summarize.py",
            "name": "raven-post-bash-summarize",
            "type": "command"
          }
        ],
        "matcher": "run_shell_command"
      },
      {
        "hooks": [
          {
            "command": "sh \"$GEMINI_PROJECT_DIR/.gemini/hooks/raven-run-hook.sh\" .gemini/hooks/raven-post-bash-truncate.py",
            "name": "raven-post-bash-truncate",
            "type": "command"
          }
        ],
        "matcher": "run_shell_command"
      },
      {
        "hooks": [
          {
            "command": "sh \"$GEMINI_PROJECT_DIR/.gemini/hooks/raven-run-hook.sh\" .gemini/hooks/raven-post-edit-format.py",
            "name": "raven-post-edit-format",
            "type": "command"
          }
        ],
        "matcher": "write_file|replace"
      }
    ],
    "BeforeTool": [
      {
        "hooks": [
          {
            "command": "sh \"$GEMINI_PROJECT_DIR/.gemini/hooks/raven-run-hook.sh\" .gemini/hooks/raven-pre-bash-guard.py",
            "name": "raven-pre-bash-guard",
            "type": "command"
          }
        ],
        "matcher": "run_shell_command"
      },
      {
        "hooks": [
          {
            "command": "sh \"$GEMINI_PROJECT_DIR/.gemini/hooks/raven-run-hook.sh\" .gemini/hooks/raven-pre-bash-test-scope.py",
            "name": "raven-pre-bash-test-scope",
            "type": "command"
          }
        ],
        "matcher": "run_shell_command"
      },
      {
        "hooks": [
          {
            "command": "sh \"$GEMINI_PROJECT_DIR/.gemini/hooks/raven-run-hook.sh\" .gemini/hooks/raven-pre-bash-cd-scope.py",
            "name": "raven-pre-bash-cd-scope",
            "type": "command"
          }
        ],
        "matcher": "run_shell_command"
      },
      {
        "hooks": [
          {
            "command": "sh \"$GEMINI_PROJECT_DIR/.gemini/hooks/raven-run-hook.sh\" .gemini/hooks/raven-pre-edit-guard.py",
            "name": "raven-pre-edit-guard",
            "type": "command"
          }
        ],
        "matcher": "write_file|replace"
      },
      {
        "hooks": [
          {
            "command": "sh \"$GEMINI_PROJECT_DIR/.gemini/hooks/raven-run-hook.sh\" .gemini/hooks/raven-session-checkpoint.py",
            "name": "raven-session-checkpoint",
            "type": "command"
          }
        ],
        "matcher": "run_shell_command"
      },
      {
        "hooks": [
          {
            "command": "sh \"$GEMINI_PROJECT_DIR/.gemini/hooks/raven-run-hook.sh\" .gemini/hooks/raven-pre-read-secret-guard.py",
            "name": "raven-pre-read-secret-guard",
            "type": "command"
          }
        ],
        "matcher": "read_file"
      },
      {
        "hooks": [
          {
            "command": "sh \"$GEMINI_PROJECT_DIR/.gemini/hooks/raven-run-hook.sh\" .gemini/hooks/raven-skeleton-read-guard.py",
            "name": "raven-skeleton-read-guard",
            "type": "command"
          }
        ],
        "matcher": "read_file"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "sh \"$GEMINI_PROJECT_DIR/.gemini/hooks/raven-run-hook.sh\" .gemini/scripts/raven-capability-roster.py",
            "name": "raven-capability-roster",
            "type": "command"
          }
        ],
        "matcher": "startup|resume|clear"
      }
    ]
  },
  "mcpServers": {
    "gitnexus": {
      "args": [
        "mcp"
      ],
      "command": "gitnexus"
    },
    "lsp": {
      "args": [
        "--workspace",
        ".",
        "--lsp",
        "lua-language-server"
      ],
      "command": "mcp-language-server"
    },
    "semgrep": {
      "args": [
        "mcp"
      ],
      "command": "semgrep"
    }
  }
}
